<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error Page Not Found</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#ef4444', // red-500
            light: '#f9fafb',   // gray-50
          }
        }
      }
    }
  </script>
</head>

<body class="bg-gray-100 min-h-screen">
  <!-- Navbar partial -->
  <%- include('../views/partials/navbar' , { isLoggedIn, user} ) %>

  <!-- Error Content -->
  <div class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4">
    <div class="max-w-xl mx-auto px-4">
      <div class="bg-white shadow-lg rounded-2xl p-8 space-y-6 border border-gray-200 text-center">
        <!-- Error Icon -->
        <div class="flex justify-center">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl font-bold">
          Page <span class="text-red-500">Not Found</span>
        </h1>

        <p class="text-gray-600">
          We can't seem to find the page you're looking for.
        </p>

        <!-- Go Home Button -->
        <a href="/" class="inline-block mt-4 w-full sm:w-auto bg-red-500 hover:bg-red-700 text-white font-medium py-2.5 px-6 rounded-full text-center transition-all duration-300 shadow-sm">
          Go to Home
        </a>
      </div>
    </div>
  </div>
</body>
</html>