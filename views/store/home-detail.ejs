<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Property Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <%- include('../partials/navbar', { isLoggedIn, user }) %>

    <main class="container mx-auto bg-white shadow-xl rounded-2xl p-10 mt-12 max-w-6xl border border-gray-200">
        <h2 class="text-4xl text-red-600 font-extrabold text-center mb-10 tracking-wide drop-shadow">
            <%= Home.housename %>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            <div class="rounded-2xl overflow-hidden shadow-lg">
                <img src="<%= Home.image %>" alt="<%= Home.housename %>" class="w-full h-96 object-cover hover:scale-105 transition-all duration-300" />
            </div>

            <div class="space-y-6">
                <div class="border-b pb-4">
                    <h3 class="text-2xl font-semibold mb-2 text-gray-800">Description</h3>
                    <p class="text-gray-600 leading-relaxed"><%= Home.description %></p>
                </div>

                <div class="border-b pb-4">
                    <h3 class="text-2xl font-semibold mb-2 text-gray-800">Location</h3>
                    <p class="text-gray-600"><%= Home.location %></p>
                </div>

                <div class="border-b pb-4">
                    <h3 class="text-2xl font-semibold mb-2 text-gray-800">Price</h3>
                    <p class="text-green-600 text-2xl font-bold">$<%= Home.price %> <span class="text-gray-500 text-lg">/ night</span></p>
                </div>

                <div class="border-b pb-4">
                    <h3 class="text-2xl font-semibold mb-2 text-gray-800">Rating</h3>
                    <div class="flex items-center space-x-2">
                        <span class="text-yellow-400 text-3xl">★</span>
                        <span class="text-lg font-medium text-gray-700"><%= Home.rating %> / 5</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row justify-center items-center space-y-4 sm:space-y-0 sm:space-x-8">
            <div class="text-center">
                <a href="/rules/<%= Home._id%>"   target="_blank" rel="noopener" class="inline-block bg-red-500 text-white px-6 py-3 rounded-full font-semibold shadow hover:bg-red-600 transition duration-200">
                    Download Rulebook (PDF)
                </a>
            </div>

            <div class="mt-4 sm:mt-0">
                <%- include('../partials/favourite', { homeId: Home.id }) %>
            </div>
        </div>
        </main>
</body>
</html>