<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/output.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#ef4444', // Tailwind red-500
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50 text-gray-800">
  <%- include('../partials/navbar' , { isLoggedIn, user } ) %>

  <div class="max-w-xl mx-auto mt-16 px-4">
    <div class="bg-white shadow-lg rounded-2xl p-8 space-y-6 border border-gray-200">
      
      <!-- Heading -->
      <h1 class="text-3xl font-bold text-center">
        <%= editing ? "Edit your" : "Register your" %> <span class="text-primary">Home</span>
      </h1>

      <!-- Form -->
      <form action="<%= editing ? '/host/edit-home/' : '/host/add-home' %>" method="POST" 
        enctype="multipart/form-data"
        class="space-y-5">

        <!-- House Name Input -->
        <div>
          <!-- Hidden field to forward MongoDB ObjectId (_id) when editing -->
            <% if (editing) { %>
            <input type="hidden" name="homeId" value="<%= home._id %>">
            <% } %>
          <label for="house" class="block text-sm font-medium text-gray-700 mb-1">House Name</label>
          <input
            type="text"
            id="house"
            name="housename"
            value="<%= (editing)?  home.housename : '' %>"
            placeholder="Enter house name"
            class="w-full px-4 py-2 text-base font-normal placeholder-gray-500 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition"
            required
          />
        </div>

        <!-- Price Input -->
        <div>
          <label for="price" class="block text-sm font-medium text-gray-700 mb-1">Price Per Night</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="text-gray-500">$</span>
            </div>
            <input
              type="number"
              id="price"
              name="price"
              value="<%= (editing)?  home.price : '' %>"
              placeholder="Enter price per night"
              class="w-full pl-8 px-4 py-2 text-base font-normal placeholder-gray-500 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition"
              min="0"
              required
            />
          </div>
        </div>

        <!-- Location Input -->
        <div>
          <label for="loc" class="block text-sm font-medium text-gray-700 mb-1">Location</label>
          <input
            type="text"
            id="loc"
            name="location"
            value="<%= (editing)?  home.location: '' %>"
            placeholder="Enter the location"
            class="w-full px-4 py-2 text-base font-normal placeholder-gray-500 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition"
            required
          />
        </div>

        <div>
          <label for="des" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea
            type="text"
            id="des"
            name="description"
            value="<%= (editing)?  home.description: '' %>"
            placeholder="Enter the description"
            class="w-full px-4 py-2 text-base font-normal placeholder-gray-500 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition"
            required
          /></textarea>
        </div>


        <!-- Image URL Input -->
        <div>
          <label for="image" class="block text-sm font-medium text-gray-700 mb-1">Image URL</label>
          <input
            type="file"
            multiple
            accept="image/jpg, image/jpeg, image/png"
            id="image"
            name="image"
            class="w-full px-4 py-2 text-base font-normal placeholder-gray-500 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition"
            required
          />
          <p class="mt-1 text-xs text-gray-500">Please enter a valid URL for your home's image</p>
        </div>

        <!-- PDF Upload Input -->
        <div>
          <label for="pdf" class="block text-sm font-medium text-gray-700 mb-1">Brochure / Document (PDF)</label>
          <input
            type="file"
            accept="application/pdf"
            id="pdf"
            name="pdf"
            class="w-full px-4 py-2 text-base font-normal placeholder-gray-500 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition"
          />
          <p class="mt-1 text-xs text-gray-500">Upload a PDF brochure or document (optional).</p>
        </div>

        <!-- Image Preview -->
        <div id="imagePreviewContainer" class="hidden">
          <p class="text-sm font-medium text-gray-700 mb-2">Image Preview:</p>
          <img 
            id="imagePreview" 
            src="" 
            alt="Home preview" 
            class="w-full h-48 object-cover rounded-lg border border-gray-200"
          >
        </div>

         

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-primary hover:bg-red-700 text-white text-base font-medium py-2.5 rounded-full transition-all duration-300 shadow-sm mt-6"
        >
          <%= editing ? "Update" : "Submit" %>
        </button>
      </form>
    </div>
  </div>

  <script>
    // Live preview for Image URL input
    document.getElementById('image').addEventListener('input', function (e) {
      const image = e.target.value;
      const previewContainer = document.getElementById('imagePreviewContainer');
      const previewImage = document.getElementById('imagePreview');

      if (image) {
        previewImage.src = image;
        previewContainer.classList.remove('hidden');
      } else {
        previewContainer.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
